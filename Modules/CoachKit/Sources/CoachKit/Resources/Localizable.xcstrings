    "coach.profile.faq.feedback.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「接收 → 训练视频」或学员详情的视频页，逐段打点后写反馈；发出的每条都会归档在该学员的反馈页。"
          }
        }
      }
    },
    "coach.profile.faq.feedback.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈写在哪里？"
          }
        }
      }
    },
    "coach.profile.faq.join.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把「我的」页里的永久邀请码发给学员，他在注册时填入即可提交申请，你在「接收 → 新学员」里确认。"
          }
        }
      }
    },
    "coach.profile.faq.join.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员怎么加入我的名下？"
          }
        }
      }
    },
    "coach.profile.faq.unbind.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员的历史数据保留在他自己的账号里，你将不再能访问；已发出的反馈会保留在学员端。"
          }
        }
      }
    },
    "coach.profile.faq.unbind.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解除关系后数据还在吗？"
          }
        }
      }
    },
    "coach.profile.faq.video.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组行会显示虚线加号，学员可以补拍；你也可以在消息里直接要求他重录某一组。"
