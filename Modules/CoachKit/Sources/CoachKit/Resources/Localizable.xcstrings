    "coach.profile.faq.feedback.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「接收 → 训练视频」或学员详情的视频页，逐段打点后写反馈；发出的每条都会归档在该学员的反馈页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Training Videos from Receive or a student's video page, add markers, then write feedback. Sent feedback is archived on that student's Feedback page."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「接收 → 訓練影片」或學員詳情的影片頁，逐段打點後寫反饋；發出的每條都會歸檔在該學員的反饋頁。"
          }
        }
      }
    },
    "coach.profile.faq.feedback.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈写在哪里？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where does feedback go?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反饋寫在哪裡？"
          }
        }
      }
    },
    "coach.profile.faq.join.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把「我的」页里的永久邀请码发给学员，他在注册时填入即可提交申请，你在「接收 → 新学员」里确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the permanent code from Profile. The student enters it during sign-up, then you confirm under Receive → New Students."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把「我的」頁裡的永久邀請碼發給學員，他在註冊時填入即可提交申請，你在「接收 → 新學員」裡確認。"
          }
        }
      }
    },
    "coach.profile.faq.join.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员怎么加入我的名下？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does a student join my roster?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學員怎麼加入我的名下？"
          }
        }
      }
    },
    "coach.profile.faq.unbind.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员的历史数据保留在他自己的账号里，你将不再能访问；已发出的反馈会保留在学员端。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their history stays in their account, but you lose access. Feedback already sent remains visible to the student."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學員的歷史資料保留在他自己的帳號裡，你將不再能訪問；已發出的反饋會保留在學員端。"
          }
        }
      }
    },
    "coach.profile.faq.unbind.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解除关系后数据还在吗？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is data kept after unlinking?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除關係後資料還在嗎？"
          }
        }
      }
    },
    "coach.profile.faq.video.answer": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组行会显示虚线加号，学员可以补拍；你也可以在消息里直接要求他重录某一组。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dashed plus lets the student add a video later. You can also message them to re-record a specific set."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組行會顯示虛線加號，學員可以補拍；你也可以在訊息裡直接要求他重錄某一組。"
          }
        }
      }
    },
    "coach.profile.faq.video.question": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员没录视频怎么办？"
