    "student.restTimerExplanationView.copy002": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically matched to your logged RPE: 2 minutes below RPE 7, 3 minutes from RPE 7 to below 9, and 4 minutes at RPE 9 or above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你记录的 RPE 自动匹配：RPE 低于 7 为 2 分钟，7 至 9 以下为 3 分钟，9 及以上为 4 分钟。"
          }
        }
      }
    },
    "student.restTimerExplanationView.copy003": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets with coach-prescribed rest times will use the coach's setting."
