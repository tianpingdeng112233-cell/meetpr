    "student.restTimerExplanationView.copy001": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest time is matched automatically"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息时间会自动匹配"
          }
