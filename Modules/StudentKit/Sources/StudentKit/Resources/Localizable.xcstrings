    "student.studentDemoSeed.copy002": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first squat set moved well. Keep the same tempo next time and stay patient off the floor on the last set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深蹲第一组速度很好，下一次保持同样节奏，最后一组不要急着起杠。"
          }
        }
      }
    },
    "student.studentDemoSeed.copy003": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bench press was stable and your elbow path was cleaner than last week. Use a two-second eccentric on accessories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卧推动作稳定，肘部路径比上周干净。辅助动作可以控制离心两秒。"
          }
        }
      }
    },
    "student.studentDemoSeed.copy004": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery looks good overall this week. Keep up the sleep and do not skip your weekend mobility work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周总体恢复不错，睡眠继续保持。周末拉伸别省。"
          }
        }
      }
    },
